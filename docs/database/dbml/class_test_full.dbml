// 城市15分钟便民生活圈与小微开店智能助手 · 数据库逻辑模型
// 版本：V2.0  生成日期：2026年10月
// 使用方式：打开 https://dbdiagram.io/d ，清空编辑器后粘贴本文件内容即可复现。
// 表分组与主题域：USR 用户画像 / SIT 空间设施 / RES 居民评估 / MER 商户招商 / COM 社区治理 / OPS 数据运营

// ===== 实体定义 =====
Table app_user {
  id bigint [pk, increment, note: '自增主键']
  user_code varchar(64) [not null, unique, note: '脱敏编号，居民 R、商户 M、社区 C 前缀']
  role_code varchar(20) [not null, default: 'RESIDENT', note: 'RESIDENT 居民 / MERCHANT 商户 / COMMUNITY 社区 / ADMIN 管理员']
  nickname varchar(50) [note: '展示名称，可为空']
  phone_hash varchar(64) [unique, note: 'SHA-256 加盐哈希，用于登录匹配，不可逆']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE/DISABLED/DELETED']
  last_login_at timestamp [note: 'UTC 时间']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']

  Note: '用户账号表：三类使用者的统一账号，只保存脱敏业务编号与手机号哈希，不落库明文手机号。'

  indexes {
    (role_code, status) [name: 'idx_app_user_role_status']
  }
}

Table user_profile {
  id bigint [pk, increment, note: '主键']
  user_id bigint [not null, note: '所属用户']
  profile_type varchar(20) [not null, note: '居民画像或商户画像']
  profile_label varchar(50) [not null, note: '如“青年夜班画像”“稳健型商户画像”']
  source varchar(20) [not null, default: 'FORM', note: '表单/多轮对话/导入']
  confidence decimal(5,2) [note: '0-100，表示标签可信程度']
  version_no int [not null, default: 1, note: '从 1 递增']
  is_current char(1) [not null, default: 'Y', note: 'Y/N，同一用户仅一条 Y']
  created_at timestamp [not null, note: '创建时间']

  Note: '用户画像表：一次画像生成的版本化结果，保留历史版本，is_current 标记当前生效画像。'

  indexes {
    (user_id, version_no) [unique, name: 'uk_user_profile_ver']
    (user_id, is_current) [name: 'idx_user_profile_cur']
  }
}

Table profile_tag {
  id bigint [pk, increment, note: '主键']
  tag_code varchar(40) [not null, unique, note: '如 NIGHT_MEDICAL、FRESH_FOOD']
  tag_name varchar(50) [not null, note: '如“夜间就医”']
  role_scope varchar(20) [not null, default: 'ALL', note: '适用角色范围']
  dimension_code varchar(30) [not null, note: '关联 FACILITY_DIMENSION 编码']
  default_weight decimal(5,2) [not null, default: 20, note: '0-100 百分比']
  status varchar(20) [not null, default: 'ACTIVE', note: '状态']
  created_at timestamp [not null, note: '创建时间']

  Note: '画像标签字典表：可配置的关注点标签库，按角色与评分维度归类，供画像生成和权重计算使用。'

  indexes {
    (dimension_code, role_scope) [name: 'idx_profile_tag_dim']
  }
}

Table user_profile_tag {
  id bigint [pk, increment, note: '主键']
  profile_id bigint [not null, note: '画像']
  tag_id bigint [not null, note: '标签']
  weight decimal(5,2) [not null, default: 20, note: '0-100 百分比，参与加权评分']
  selected_at timestamp [not null, note: '选取时间']

  Note: '用户画像标签明细表：画像与标签的多对多关联，记录用户勾选/对话提取出的标签及个性化权重。'

  indexes {
    (profile_id, tag_id) [unique, name: 'uk_profile_tag']
  }
}

Table profile_dimension_weight {
  id bigint [pk, increment, note: '主键']
  profile_id bigint [not null, note: '画像']
  dimension_code varchar(30) [not null, note: 'FRESH/MEDICAL/EDU/TRAFFIC/NIGHT']
  dimension_name varchar(50) [not null, note: '生鲜购物/医疗健康/亲子教育/交通通勤/夜间服务']
  weight decimal(5,2) [not null, note: '0-100 百分比']
  updated_at timestamp [not null, note: '更新时间']

  Note: '画像维度权重表：画像对五个评分维度的最终权重，居民评估时按该表动态加权，权重之和应为 100。'

  indexes {
    (profile_id, dimension_code) [unique, name: 'uk_profile_dim']
  }
}

Table district {
  id bigint [pk, increment, note: '主键']
  district_code varchar(40) [not null, unique, note: '行政区划码+序号，全局唯一']
  district_name varchar(100) [not null, note: '片区名称']
  parent_id bigint [note: '自关联，街道→社区→网格']
  district_level varchar(20) [not null, note: 'STREET/COMMUNITY/GRID']
  city_code varchar(20) [not null, note: 'GB/T 2260 六位代码']
  center_lng decimal(10,6) [note: 'WGS84，单位度']
  center_lat decimal(10,6) [note: 'WGS84，单位度']
  boundary_geojson text [note: '片区边界，GeoJSON Polygon']
  area_sqm decimal(12,2) [note: '平方米']
  resident_count int [note: '人']
  status varchar(20) [not null, default: 'ACTIVE', note: '状态']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']

  Note: '社区片区表：街道—社区—网格三级空间主数据，是设施、评估、选址和治理的公共维度。'

  indexes {
    parent_id [name: 'idx_district_parent']
    (city_code, district_level) [name: 'idx_district_city']
  }
}

Table population_grid {
  id bigint [pk, increment, note: '主键']
  district_id bigint [not null, note: '所属片区']
  grid_code varchar(40) [not null, note: '统一栅格编码']
  grid_level varchar(20) [not null, default: 'GRID_250M', note: '栅格精度']
  center_lng decimal(10,6) [not null, note: '栅格中心经度']
  center_lat decimal(10,6) [not null, note: '栅格中心纬度']
  population int [not null, note: '人']
  density decimal(12,2) [note: '人/平方公里']
  data_date date [not null, note: '人口数据口径日期']
  source varchar(20) [not null, default: 'GOV', note: '数据来源']
  created_at timestamp [not null, note: '入库时间']

  Note: '人口栅格表：按栅格与统计日期保存常住人口和密度，是商户选址人口指数与社区覆盖测算的输入。'

  indexes {
    (grid_code, data_date) [unique, name: 'uk_pop_grid_date']
    (district_id, data_date) [name: 'idx_pop_district_date']
  }
}

Table road_node {
  id bigint [pk, increment, note: '主键']
  node_code varchar(40) [not null, unique, note: '节点编码']
  district_id bigint [note: '所属片区']
  lng decimal(10,6) [not null, note: '经度']
  lat decimal(10,6) [not null, note: '纬度']
  node_type varchar(20) [not null, default: 'INTERSECTION', note: '节点类型']
  updated_at timestamp [not null, note: '更新时间']

  Note: '路网节点表：步行路网拓扑节点（路口、小区出入口、过街设施），用于 15 分钟步行可达计算。'

  indexes {
    district_id [name: 'idx_road_node_district']
  }
}

Table road_segment {
  id bigint [pk, increment, note: '主键']
  segment_code varchar(50) [not null, unique, note: '路段编码']
  district_id bigint [note: '所属片区']
  from_node_id bigint [not null, note: '起点节点']
  to_node_id bigint [not null, note: '终点节点']
  road_name varchar(100) [note: '道路名称']
  road_level varchar(20) [not null, default: 'BRANCH', note: '道路等级']
  length_m decimal(10,2) [not null, note: '米']
  walk_time_s int [not null, note: '秒，按 1.2 m/s 及过街等待估算']
  is_walkable char(1) [not null, default: 'Y', note: '是否可步行']
  updated_at timestamp [not null, note: '更新时间']

  Note: '路网步行段表：连接两个路网节点的步行段，保存长度与步行耗时，构成 15 分钟等时圈的图结构。'

  indexes {
    from_node_id [name: 'idx_road_seg_from']
    to_node_id [name: 'idx_road_seg_to']
    district_id [name: 'idx_road_seg_district']
  }
}

Table facility_category {
  id bigint [pk, increment, note: '主键']
  category_code varchar(40) [not null, unique, note: '如 FRESH_MARKET、CLINIC']
  category_name varchar(50) [not null, note: '如“社区诊所”']
  dimension_code varchar(30) [not null, note: 'FRESH/MEDICAL/EDU/TRAFFIC/NIGHT']
  dimension_name varchar(50) [not null, note: '评分维度名称']
  icon varchar(100) [note: '前端图标名']
  sort_no int [not null, default: 0, note: '排序号']
  status varchar(20) [not null, default: 'ACTIVE', note: '状态']
  created_at timestamp [not null, note: '创建时间']

  Note: '设施类别字典表：POI 类别与五维评分的映射字典，统一高德分类与业务维度，避免代码硬编码。'

  indexes {
    (dimension_code, sort_no) [name: 'idx_fac_category_dim']
  }
}

Table poi_facility {
  id bigint [pk, increment, note: '主键']
  district_id bigint [not null, note: '所属片区']
  category_id bigint [not null, note: '设施类别']
  poi_name varchar(200) [not null, note: '设施名称']
  lng decimal(10,6) [not null, note: '经度']
  lat decimal(10,6) [not null, note: '纬度']
  address varchar(255) [note: '详细地址']
  business_status varchar(20) [not null, default: 'OPEN', note: '营业状态']
  source varchar(20) [not null, note: '数据来源']
  source_poi_id varchar(100) [not null, note: '高德 POI ID 或政务数据主键，用于增量去重']
  telephone varchar(50) [note: '仅公共设施公开电话，不含个人信息']
  first_seen_at timestamp [not null, note: '首次发现时间']
  last_seen_at timestamp [not null, note: '最近发现时间']
  updated_at timestamp [not null, note: '更新时间']
  is_valid char(1) [not null, default: 'Y', note: '是否有效']

  Note: '设施网点 POI 表：社区周边生鲜、医疗、教育、交通、夜间服务等设施网点，是评估与选址的主数据。'

  indexes {
    (source, source_poi_id) [unique, name: 'uk_poi_source']
    (district_id, category_id) [name: 'idx_poi_district_cat']
    (category_id, is_valid) [name: 'idx_poi_category']
    poi_name [name: 'idx_poi_name']
  }
}

Table poi_change_log {
  id bigint [pk, increment, note: '主键']
  poi_id bigint [note: '设施']
  batch_id bigint [not null, note: '同步批次']
  change_type varchar(20) [not null, note: '变更类型']
  change_summary varchar(500) [note: '如“地址变更”“营业状态 OPEN→CLOSED”']
  before_json text [note: 'JSON 快照，便于回滚']
  after_json text [note: 'JSON 快照']
  changed_at timestamp [not null, note: '变更时间']

  Note: 'POI 变更日志表：记录新增、变更、关停和清洗无效的 POI 差异，支持增量追溯与数据质量审计。'

  indexes {
    (poi_id, changed_at) [name: 'idx_poi_log_poi']
    batch_id [name: 'idx_poi_log_batch']
  }
}

Table resident_assessment {
  id bigint [pk, increment, note: '主键']
  resident_code varchar(64) [not null, note: '脱敏居民编号，未登录用户也可评估']
  user_id bigint [note: '用户']
  district_id bigint [not null, note: '目标片区']
  profile_id bigint [note: '个性化权重来源']
  batch_id bigint [note: '评估使用的 POI/人口数据版本']
  radius_m int [not null, default: 1080, note: '米，15 分钟按 1.2 m/s 约 1080 m']
  total_score int [not null, note: '0-100']
  profile_label varchar(50) [note: '冗余画像标签，便于列表展示']
  insight varchar(1000) [note: 'Agent 生成的优缺点诊断']
  assessed_at timestamp [not null, note: '评估时间']

  Note: '居民生活圈评估表：一次居民生活圈体检的汇总结果，保存评分、画像、步行半径和诊断结论。'

  indexes {
    (district_id, assessed_at) [name: 'idx_assess_district_time']
    (user_id, assessed_at) [name: 'idx_assess_user']
    batch_id [name: 'idx_assess_batch']
  }
}

Table assessment_dimension {
  id bigint [pk, increment, note: '主键']
  assessment_id bigint [not null, note: '评估记录']
  dimension_code varchar(30) [not null, note: '维度编码']
  dimension_name varchar(50) [not null, note: '维度名称']
  dimension_score int [not null, note: '维度得分']
  weight decimal(5,2) [not null, note: '来自画像，百分比']
  facility_count int [not null, default: 0, note: '设施数量']

  Note: '评估维度得分表：五维评分的分项结果，保存得分、权重和设施计数，支撑雷达图与可解释性。'

  indexes {
    (assessment_id, dimension_code) [unique, name: 'uk_assess_dim']
  }
}

Table assessment_facility_stat {
  id bigint [pk, increment, note: '主键']
  assessment_id bigint [not null, note: '评估记录']
  category_id bigint [not null, note: '设施类别']
  facility_count int [not null, default: 0, note: '设施数量']
  nearest_distance_m decimal(10,2) [note: '米']
  status varchar(20) [note: '充足/基本满足/待改善，与前端枚举逐字一致']

  Note: '评估设施盘点表：一次评估中各设施类别的数量、最近距离与状态，用于设施清单和短板定位。'

  indexes {
    (assessment_id, category_id) [unique, name: 'uk_assess_category']
  }
}

Table district_score_snapshot {
  id bigint [pk, increment, note: '主键']
  district_id bigint [not null, note: '片区']
  batch_id bigint [note: '数据批次']
  coverage_pct int [not null, note: '%，15 分钟覆盖人口占比']
  avg_score decimal(5,2) [not null, note: '平均评分']
  rank_no int [note: '辖区排名']
  resident_count int [note: '覆盖人口']
  scored_at timestamp [not null, note: '计算时间']

  Note: '片区评分快照表：每次数据同步后按片区重算的便民评分与排名，供社区热力图、排名和趋势查询。'

  indexes {
    (district_id, batch_id) [unique, name: 'uk_district_batch']
    scored_at [name: 'idx_district_score_time']
  }
}

Table site_candidate {
  id bigint [pk, increment, note: '主键']
  district_id bigint [not null, note: '所属片区']
  batch_id bigint [note: '数据批次']
  candidate_name varchar(100) [not null, note: '如“东园路口”']
  business_type varchar(100) [note: '早餐、便利店、托育、药店等']
  lng decimal(10,6) [note: '经度']
  lat decimal(10,6) [note: '纬度']
  population_index decimal(10,2) [note: '候选项半径内人口/密度综合指数']
  competitor_count int [note: '候选点 15 分钟范围内同业态 POI 数']
  demand_level varchar(10) [note: '高/中高/中/低']
  competition_level varchar(10) [note: '低/中/高']
  rent_min decimal(8,2) [note: '万元/年']
  rent_max decimal(8,2) [note: '万元/年']
  site_score int [note: '选址评分']
  created_at timestamp [not null, note: '生成时间']

  Note: '商户选址候选点表：Agent 依据人口栅格与同业态竞争 POI 推演出的候选点位，含评分与关键指标。'

  indexes {
    (district_id, business_type, site_score) [name: 'idx_site_district_type']
    batch_id [name: 'idx_site_batch']
  }
}

Table site_score_item {
  id bigint [pk, increment, note: '主键']
  candidate_id bigint [not null, note: '候选点']
  score_item varchar(50) [not null, note: '人口密度/竞争饱和度/租金/交通/设施缺口']
  item_score decimal(5,2) [not null, note: '得分']
  weight decimal(5,2) [not null, note: '权重']
  reason varchar(255) [note: '给商户看的解释文本']

  Note: '选址评分明细表：候选点各评分项的分值、权重与理由，保证选址推荐可解释、可复核。'

  indexes {
    (candidate_id, score_item) [unique, name: 'uk_site_score_item']
  }
}

Table merchant_intent {
  id bigint [pk, increment, note: '主键']
  merchant_name varchar(100) [not null, note: '商户名称']
  business_type varchar(100) [not null, note: '经营业态']
  contact varchar(200) [not null, note: 'AES-256-GCM 加密后 Base64，禁止明文落库；接口层解密']
  contact_masked varchar(20) [note: '如 138****8000，列表展示用']
  district_id bigint [note: '意向片区']
  candidate_id bigint [note: '意向候选点']
  budget_min decimal(8,2) [note: '万元']
  budget_max decimal(8,2) [note: '万元']
  area_sqm decimal(8,2) [note: '平方米']
  remark varchar(500) [note: '经营说明']
  status varchar(20) [not null, default: 'SUBMITTED', note: '意向状态']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']

  Note: '商户开店意向表：商户提交的开店意向，保留原有字段并扩展片区、候选点、预算和状态，兼容现有接口。'

  indexes {
    (status, created_at) [name: 'idx_intent_status_time']
    district_id [name: 'idx_intent_district']
    candidate_id [name: 'idx_intent_candidate']
  }
}

Table merchant_match {
  id bigint [pk, increment, note: '主键']
  intent_id bigint [not null, note: '开店意向']
  district_id bigint [not null, note: '片区']
  gap_id bigint [note: '对应短板']
  fit_score int [not null, note: '匹配度']
  match_reason varchar(500) [note: '匹配理由']
  status varchar(20) [not null, default: 'PENDING', note: '对接状态']
  matched_at timestamp [not null, note: '匹配时间']

  Note: '招商匹配表：社区短板与商户意向的双向匹配结果，记录匹配分、理由和对接状态。'

  indexes {
    intent_id [name: 'idx_match_intent']
    gap_id [name: 'idx_match_gap']
    (district_id, fit_score) [name: 'idx_match_district_score']
  }
}

Table community_gap {
  id bigint [pk, increment, note: '主键']
  district_id bigint [not null, note: '片区']
  category_id bigint [not null, note: '设施类别']
  area_name varchar(100) [not null, note: '短板区域名称']
  issue varchar(200) [not null, note: '如“夜间就医距离较远”']
  gap_level varchar(10) [not null, note: '高/中/低，与前端枚举一致']
  uncovered_residents int [note: '人']
  priority_no int [note: '1 为最高']
  batch_id bigint [note: '数据批次']
  created_at timestamp [not null, note: '创建时间']

  Note: '社区短板片区表：社区识别出的买菜难、就医远、托育不足等短板，含缺口等级、未覆盖人口与优先级。'

  indexes {
    (district_id, gap_level) [name: 'idx_gap_district_level']
    category_id [name: 'idx_gap_category']
    batch_id [name: 'idx_gap_batch']
  }
}

Table simulation_record {
  id bigint [pk, increment, note: '主键']
  district_id bigint [not null, note: '片区']
  category_id bigint [not null, note: '设施类别']
  business_type varchar(100) [note: '模拟业态']
  lng decimal(10,6) [note: '模拟点经度']
  lat decimal(10,6) [note: '模拟点纬度']
  before_coverage int [not null, note: '%']
  after_coverage int [not null, note: '%']
  benefited_residents int [not null, note: '受益人口']
  operator varchar(50) [note: '社区工作人员编号']
  simulated_at timestamp [not null, note: '模拟时间']

  Note: '网点增设模拟记录表：社区在地图上模拟新增便民网点后的覆盖率、受益人口和前后对比，支撑改造决策。'

  indexes {
    (district_id, simulated_at) [name: 'idx_sim_district_time']
  }
}

Table sync_batch {
  id bigint [pk, increment, note: '主键']
  batch_no varchar(40) [not null, unique, note: '如 POI-20261015-01']
  data_source varchar(20) [not null, note: '数据来源']
  sync_type varchar(20) [not null, note: '同步类型']
  started_at timestamp [not null, note: '开始时间']
  finished_at timestamp [note: '结束时间']
  total_count int [not null, default: 0, note: '处理总数']
  insert_count int [not null, default: 0, note: '新增数']
  update_count int [not null, default: 0, note: '变更数']
  close_count int [not null, default: 0, note: '关停数']
  invalid_count int [not null, default: 0, note: '无效数']
  status varchar(20) [not null, default: 'RUNNING', note: '批次状态']
  error_msg varchar(1000) [note: '错误信息']
  created_at timestamp [not null, note: '创建时间']

  Note: '数据同步批次表：每半月一次 POI/人口/路网增量同步的批次台账，记录数量、状态与错误信息。'

  indexes {
    (status, started_at) [name: 'idx_sync_status_time']
  }
}

Table data_quality_issue {
  id bigint [pk, increment, note: '主键']
  batch_id bigint [not null, note: '同步批次']
  poi_id bigint [note: '设施']
  rule_code varchar(40) [not null, note: '如 DUP_POI、COORD_OUT_OF_RANGE']
  issue_desc varchar(500) [not null, note: '问题描述']
  severity varchar(20) [not null, note: '严重程度']
  is_handled char(1) [not null, default: 'N', note: '是否已处理']
  handled_at timestamp [note: '处理时间']
  created_at timestamp [not null, note: '创建时间']

  Note: '数据质量问题表：同步过程中的重复、坐标异常、类别缺失等质量问题及处理状态，支撑数据治理闭环。'

  indexes {
    (batch_id, severity, is_handled) [name: 'idx_dq_batch_severity']
  }
}

Table ods_poi_raw {
  id bigint [pk, increment, note: '主键']
  batch_id bigint [not null, note: '同步批次']
  source varchar(20) [not null, note: '数据来源']
  source_poi_id varchar(100) [not null, note: '来源 POI 编号']
  poi_name varchar(200) [note: '设施名称']
  lng decimal(10,6) [note: '经度']
  lat decimal(10,6) [note: '纬度']
  category_raw varchar(100) [note: '原始类别']
  address varchar(255) [note: '原始地址']
  raw_json text [not null, note: '接口返回 JSON 原样保存']
  load_at timestamp [not null, note: '入库时间']
  process_status varchar(20) [not null, default: 'PENDING', note: '处理状态']

  Note: 'POI 原始数据表：高德/政务 POI 接口原始报文落地，保留原样 JSON，供清洗、重放和审计。'

  indexes {
    (batch_id, process_status) [name: 'idx_ods_poi_batch']
    (source, source_poi_id) [name: 'idx_ods_poi_source']
  }
}

Table ods_population_raw {
  id bigint [pk, increment, note: '主键']
  batch_id bigint [not null, note: '同步批次']
  grid_code varchar(40) [not null, note: '栅格编码']
  population int [note: '人口数']
  density decimal(12,2) [note: '人口密度']
  data_date date [note: '统计日期']
  raw_json text [not null, note: '原始报文']
  load_at timestamp [not null, note: '入库时间']
  process_status varchar(20) [not null, default: 'PENDING', note: '处理状态']

  Note: '人口栅格原始数据表：人口栅格文件/接口的原始统计值，按批次保留，供复算和口径追溯。'

  indexes {
    (batch_id, process_status) [name: 'idx_ods_pop_batch']
  }
}

Table ods_road_raw {
  id bigint [pk, increment, note: '主键']
  batch_id bigint [not null, note: '同步批次']
  segment_code varchar(50) [note: '路段编码']
  raw_json text [not null, note: '原始报文']
  load_at timestamp [not null, note: '入库时间']
  process_status varchar(20) [not null, default: 'PENDING', note: '处理状态']

  Note: '路网原始数据表：路网数据文件的原始路段记录，保留几何与属性原文，供拓扑重建。'

  indexes {
    (batch_id, process_status) [name: 'idx_ods_road_batch']
  }
}

// ===== 关系定义 =====
Ref: user_profile.user_id > app_user.id
Ref: user_profile_tag.profile_id > user_profile.id
Ref: user_profile_tag.tag_id > profile_tag.id
Ref: profile_dimension_weight.profile_id > user_profile.id
Ref: district.parent_id > district.id
Ref: population_grid.district_id > district.id
Ref: road_node.district_id > district.id
Ref: road_segment.district_id > district.id
Ref: road_segment.from_node_id > road_node.id
Ref: road_segment.to_node_id > road_node.id
Ref: poi_facility.district_id > district.id
Ref: poi_facility.category_id > facility_category.id
Ref: poi_change_log.poi_id > poi_facility.id
Ref: poi_change_log.batch_id > sync_batch.id
Ref: resident_assessment.user_id > app_user.id
Ref: resident_assessment.district_id > district.id
Ref: resident_assessment.profile_id > user_profile.id
Ref: resident_assessment.batch_id > sync_batch.id
Ref: assessment_dimension.assessment_id > resident_assessment.id
Ref: assessment_facility_stat.assessment_id > resident_assessment.id
Ref: assessment_facility_stat.category_id > facility_category.id
Ref: district_score_snapshot.district_id > district.id
Ref: district_score_snapshot.batch_id > sync_batch.id
Ref: site_candidate.district_id > district.id
Ref: site_candidate.batch_id > sync_batch.id
Ref: site_score_item.candidate_id > site_candidate.id
Ref: merchant_intent.district_id > district.id
Ref: merchant_intent.candidate_id > site_candidate.id
Ref: merchant_match.intent_id > merchant_intent.id
Ref: merchant_match.district_id > district.id
Ref: merchant_match.gap_id > community_gap.id
Ref: community_gap.district_id > district.id
Ref: community_gap.category_id > facility_category.id
Ref: community_gap.batch_id > sync_batch.id
Ref: simulation_record.district_id > district.id
Ref: simulation_record.category_id > facility_category.id
Ref: data_quality_issue.batch_id > sync_batch.id
Ref: data_quality_issue.poi_id > poi_facility.id
Ref: ods_poi_raw.batch_id > sync_batch.id
Ref: ods_population_raw.batch_id > sync_batch.id
Ref: ods_road_raw.batch_id > sync_batch.id

// ===== 主题域分组 =====
TableGroup "用户与画像" {
  app_user
  user_profile
  profile_tag
  user_profile_tag
  profile_dimension_weight
}

TableGroup "空间与设施" {
  district
  population_grid
  road_node
  road_segment
  facility_category
  poi_facility
}

TableGroup "居民生活圈评估" {
  resident_assessment
  assessment_dimension
  assessment_facility_stat
  district_score_snapshot
}

TableGroup "商户选址与招商" {
  site_candidate
  site_score_item
  merchant_intent
  merchant_match
}

TableGroup "社区治理" {
  community_gap
  simulation_record
}

TableGroup "数据运营与同步" {
  poi_change_log
  sync_batch
  data_quality_issue
  ods_poi_raw
  ods_population_raw
  ods_road_raw
}
